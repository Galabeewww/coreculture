# ==========================================
# CONTOH VARIABEL LINGKUNGAN (ENVIRONMENT VARIABLES)
# Salin file ini menjadi .env.local untuk pengembangan lokal
# ==========================================

# 1. KONEKSI DATABASE POSTGRESQL (PRISMA ORM)
# ------------------------------------------
# A. LOKAL (pgAdmin4 / PostgreSQL di Komputer Lokal):
DATABASE_URL="postgresql://postgres:password_lokal_anda@localhost:5432/nama_db_anda?schema=public"

# B. ONLINE (Supabase PostgreSQL saat Deploy ke Vercel):
# Dapatkan dari Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Pooler)
# DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. INTEGRASI CLOUDINARY (PENYIMPANAN FOTO ON-THE-FLY)
# ----------------------------------------------------
# Dapatkan dari Cloudinary Dashboard -> Account Details
CLOUDINARY_CLOUD_NAME="nama_cloud_anda"
CLOUDINARY_API_KEY="key_api_anda"
CLOUDINARY_API_SECRET="secret_api_anda"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="nama_cloud_anda"
